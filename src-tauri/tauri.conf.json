{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroPlayer",
  "version": "1.0.0",
  "identifier": "com.aeroplayer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "AeroPlayer",
        "width": 1200,
        "height": 780,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Video",
    "copyright": "",
    "shortDescription": "Desktop Media Player",
    "longDescription": "High-performance cross-platform desktop media player with HLS streaming and hover thumbnail previews.",
    "targets": "all"
  }
}
